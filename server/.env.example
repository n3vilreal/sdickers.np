PORT=3000

# Supabase Postgres connection string
# Supabase Dashboard -> Project Settings -> Database -> Connect -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Secret used to sign JWT tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SECRET_KEY=generate_a_long_random_string_here

# Gmail account for sending OTP emails (Google Account -> Security -> App Passwords)
# Note: the # character breaks dotenv values unless quoted
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Admin account auto-created on first server start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="admin_password_with_special_chars"
ADMIN_PHONE=9800000000
ADMIN_USERNAME=Admin

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
